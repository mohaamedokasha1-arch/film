<%- include('../partials/header') %>

<div class="container movie-detail-wrap">
  <%- include('../partials/breadcrumbs', { breadcrumbs }) %>

  <!-- Header Ad Placeholder -->
  <%- include('../partials/adSlot', { position: 'header' }) %>

  <!-- Video Player Box -->
  <div class="player-container">
    <% if (movie.embed_url) { %>
      <iframe 
        src="<%= movie.embed_url %>" 
        title="<%= movie.title %> streaming player"
        allowfullscreen 
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      ></iframe>
    <% } else if (movie.video_url) { %>
      <video controls poster="<%= movie.poster_url %>" style="width: 100%; height: 100%;">
        <source src="<%= movie.video_url %>" type="<%= /\.webm(\?|$)/i.test(movie.video_url || '') ? 'video/webm' : (/\.ogv(\?|$)/i.test(movie.video_url || '') ? 'video/ogg' : 'video/mp4') %>">
        Your browser does not support the video tag.
      </video>
    <% } else { %>
      <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; text-align: center; padding: 2rem;">
        <h3 style="margin-bottom: 0.5rem;">Watch directly on Internet Archive</h3>
        <p style="color: var(--text-muted); margin-bottom: 1.5rem;">External streaming link available on the official preservation record.</p>
        <a href="<%= movie.source_url %>" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          Open Film on Archive.org &rarr;
        </a>
      </div>
    <% } %>
  </div>

  <!-- Movie Header & Details Layout -->
  <div class="movie-header-block">
    <div class="movie-poster-col">
      <img src="<%= movie.poster_url || '/images/placeholder-poster.svg' %>" alt="<%= movie.title %> official poster" class="movie-poster-img">
      
      <div style="margin-top: 1.25rem; display: flex; flex-direction: column; gap: 0.65rem;">
        <a href="<%= movie.source_url %>" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm" style="width: 100%;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
          View Source Archive
        </a>
        <a href="<%= movie.license_url %>" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm" style="width: 100%;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
          Official License Terms
        </a>
      </div>
    </div>

    <div class="movie-details-col">
      <div class="movie-meta-chips">
        <% if (movie.year) { %>
          <a href="/year/<%= movie.year %>" class="badge badge-gold"><%= movie.year %></a>
        <% } %>
        <% if (movie.duration) { %>
          <span class="badge" style="background: rgba(255,255,255,0.08); color: #fff;"><%= movie.duration %> MIN</span>
        <% } %>
        <span class="badge badge-pd"><%= movie.license_type %></span>
        <span class="badge" style="background: rgba(255,255,255,0.08); color: #fff;"><%= movie.language || 'English' %></span>
      </div>

      <h1 class="movie-h1"><%= movie.title %></h1>

      <!-- Genre Badges -->
      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.5rem;">
        <% 
          let genresArr = [];
          try {
            genresArr = Array.isArray(movie.genres) ? movie.genres : JSON.parse(movie.genres || '[]');
          } catch(e) { genresArr = ['Classic']; }
        %>
        <% genresArr.forEach(g => { %>
          <a href="/genre/<%= g.toLowerCase().replace(/[^a-z0-9]+/g, '-') %>" class="badge-genre">
            <%= g %>
          </a>
        <% }); %>
      </div>

      <!-- Director & Cast Information -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border-color);">
        <div>
          <span style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-dim); display: block;">Director</span>
          <span style="font-weight: 600; color: #ffffff;"><%= movie.director || 'Unknown Classic Director' %></span>
        </div>
        <% 
          let castList = [];
          try {
            castList = Array.isArray(movie.cast_members) ? movie.cast_members : JSON.parse(movie.cast_members || '[]');
          } catch(e) {}
        %>
        <% if (castList && castList.length > 0) { %>
          <div>
            <span style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-dim); display: block;">Starring</span>
            <span style="color: var(--text-main); font-size: 0.9rem;"><%= castList.join(', ') %></span>
          </div>
        <% } %>
      </div>

      <!-- Synopsis -->
      <div style="margin-bottom: 1.5rem;">
        <h3 style="font-size: 1.15rem; margin-bottom: 0.5rem;">Synopsis & Background</h3>
        <p style="color: var(--text-muted); line-height: 1.7; white-space: pre-line; font-size: 0.95rem;">
          <%= movie.description %>
        </p>
      </div>

      <!-- In-Content Ad Placeholder -->
      <%- include('../partials/adSlot', { position: 'incontent' }) %>

      <!-- Legal & License Compliance Card -->
      <div class="legal-card">
        <div class="legal-card-header">
          <div class="legal-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 12 11 14 15 10"></polyline></svg>
            Verified Legal Cultural Asset
          </div>
          <span class="badge badge-pd">100% LEGAL TO WATCH & SHARE</span>
        </div>
        
        <p style="font-size: 0.85rem; color: #d1d5db; line-height: 1.6; margin-bottom: 0.5rem;">
          <strong>Rights Statement:</strong> <%= movie.rights_statement || 'This cinematic work is in the Public Domain worldwide, free of active commercial copyright claims.' %>
        </p>

        <% if (movie.attribution_required && movie.attribution_text) { %>
          <div style="margin-top: 0.75rem;">
            <span style="font-size: 0.75rem; font-weight: 600; color: #fbbf24; text-transform: uppercase;">Required Attribution Statement:</span>
            <div class="attribution-box">
              <span><%= movie.attribution_text %></span>
              <button type="button" class="btn btn-secondary btn-sm" id="copy-attribution-btn" data-text="<%= movie.attribution_text %>">
                Copy
              </button>
            </div>
          </div>
        <% } %>

        <div style="margin-top: 0.85rem; font-size: 0.75rem; color: var(--text-dim); display: flex; gap: 1rem; flex-wrap: wrap;">
          <span>Source: <a href="<%= movie.source_url %>" target="_blank" rel="noopener" style="color: var(--primary);"><%= movie.source_name || 'Internet Archive' %> (<%= movie.external_id %>)</a></span>
          <span>•</span>
          <span>License: <a href="<%= movie.license_url %>" target="_blank" rel="noopener" style="color: var(--primary);"><%= movie.license_type %></a></span>
        </div>
      </div>
    </div>
  </div>

  <!-- Related Movies -->
  <% if (relatedMovies && relatedMovies.length > 0) { %>
    <section style="margin-top: 4rem;">
      <div class="section-header">
        <div>
          <h2 class="section-title">Related Classic Films</h2>
          <p class="section-subtitle">More films from related genres and eras</p>
        </div>
      </div>
      <div class="movies-grid">
        <% relatedMovies.forEach(rel => { %>
          <%- include('../partials/movieCard', { movie: rel }) %>
        <% }); %>
      </div>
    </section>
  <% } %>

  <!-- Footer Ad Placeholder -->
  <%- include('../partials/adSlot', { position: 'footer' }) %>
</div>

<%- include('../partials/footer') %>
