<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Import Audit Logs | CineArchive Admin</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="admin-body">
  <div class="admin-layout">
    <%- include('sidebar', { activePage: 'logs' }) %>

    <div class="admin-main">
      <%- include('topbar', { pageTitle: 'Import Audit Logs & Run History' }) %>

      <main class="admin-content">
        <div class="table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Log ID</th>
                <th>Run Started</th>
                <th>Duration</th>
                <th>Found</th>
                <th>Imported</th>
                <th>Skipped</th>
                <th>License Rejections</th>
                <th>Duplicates</th>
                <th>Status</th>
                <th>Details</th>
              </tr>
            </thead>
            <tbody>
              <% if (logs.length === 0) { %>
                <tr>
                  <td colspan="10" style="text-align: center; padding: 3rem; color: var(--text-muted);">
                    No import logs recorded yet.
                  </td>
                </tr>
              <% } %>
              <% logs.forEach(log => { %>
                <tr>
                  <td><strong>#<%= log.id %></strong></td>
                  <td><%= new Date(log.started_at).toLocaleString() %></td>
                  <td><%= log.duration_seconds %>s</td>
                  <td><%= log.items_found %></td>
                  <td><strong style="color: #34d399;">+<%= log.items_imported %></strong></td>
                  <td><%= log.items_skipped %></td>
                  <td><span style="color: #fb7185; font-weight: 600;"><%= log.license_rejections %></span></td>
                  <td><span style="color: #fbbf24;"><%= log.duplicate_rejections %></span></td>
                  <td>
                    <% if (log.status === 'success') { %>
                      <span class="badge badge-pd">Success</span>
                    <% } else if (log.status === 'partial') { %>
                      <span class="badge badge-gold">Partial</span>
                    <% } else if (log.status === 'running') { %>
                      <span class="badge" style="background: rgba(59,130,246,0.2); color: #60a5fa;">Running...</span>
                    <% } else { %>
                      <span class="badge" style="background: rgba(239,68,68,0.2); color: #f87171;">Failed</span>
                    <% } %>
                  </td>
                  <td>
                    <details>
                      <summary style="cursor: pointer; color: var(--primary); font-size: 0.8rem;">View Events</summary>
                      <div style="background: #000; padding: 0.75rem; border-radius: var(--radius-sm); margin-top: 0.5rem; max-height: 200px; overflow-y: auto; font-family: var(--font-mono); font-size: 0.75rem; color: #cbd5e1; width: 450px;">
                        <% if (log.error_message) { %>
                          <div style="color: #ef4444; margin-bottom: 0.5rem;"><strong>Error:</strong> <%= log.error_message %></div>
                        <% } %>
                        <% 
                          let evs = [];
                          try { evs = JSON.parse(log.log_details || '[]'); } catch(e){}
                          evs.forEach(ev => {
                        %>
                          <div style="margin-bottom: 0.25rem;">
                            <span style="color: #64748b;">[<%= ev.time ? new Date(ev.time).toLocaleTimeString() : '' %>]</span> <%= ev.message %>
                          </div>
                        <% }); %>
                      </div>
                    </details>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </main>
    </div>
  </div>
</body>
</html>
