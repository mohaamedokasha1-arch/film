<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>SEO Settings | AKASHA HUB Admin</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body class="admin-body">
  <div class="admin-layout">
    <%- include('sidebar', { activePage: 'settingsSeo' }) %>

    <div class="admin-main">
      <%- include('topbar', { pageTitle: 'SEO Automation & Meta Configuration' }) %>

      <main class="admin-content" style="max-width: 800px;">
        <% if (typeof successMessage !== 'undefined' && successMessage) { %>
          <div style="background: rgba(16,185,129,0.15); border: 1px solid rgba(16,185,129,0.35); padding: 1rem; border-radius: var(--radius-sm); color: #34d399; margin-bottom: 1.5rem;">
            <%= successMessage %>
          </div>
        <% } %>

        <div style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 2rem;">
          <form action="/admin/settings/seo" method="POST">
            <div class="form-group">
              <label class="form-label">Movie Detail Page Title Template</label>
              <input type="text" name="seo_title_template" value="<%= siteSettings.seo_title_template %>" class="form-input" required>
              <div class="form-help">Variables available: <code>{title}</code>, <code>{year}</code>, <code>{site_name}</code></div>
            </div>

            <div class="form-group">
              <label class="form-label">Movie Meta Description Template</label>
              <textarea name="seo_meta_template" class="form-textarea" required><%= siteSettings.seo_meta_template %></textarea>
              <div class="form-help">Variables available: <code>{title}</code>, <code>{year}</code>, <code>{director}</code>, <code>{genre}</code>, <code>{license_type}</code>, <code>{site_name}</code></div>
            </div>

            <div class="form-group">
              <label class="form-label">Default Open Graph / Social Share Image</label>
              <input type="text" name="seo_default_og_image" value="<%= siteSettings.seo_default_og_image %>" class="form-input" required>
              <div class="form-help">Fallback image used when a movie has no dedicated poster.</div>
            </div>

            <!-- SEO Status Cards -->
            <div style="background: var(--bg-surface-elevated); padding: 1.25rem; border-radius: var(--radius-sm); border: 1px solid var(--border-color); margin-top: 1.5rem;">
              <h4 style="font-size: 0.95rem; color: #fff; margin-bottom: 0.75rem;">Active SEO Automations</h4>
              <ul style="font-size: 0.85rem; color: var(--text-muted); display: flex; flex-direction: column; gap: 0.5rem; margin-left: 1.25rem;">
                <li>✓ <strong>Structured Data:</strong> Schema.org <code>Movie</code> JSON-LD injected on all detail pages.</li>
                <li>✓ <strong>BreadcrumbList:</strong> Schema.org hierarchy for search rich snippets.</li>
                <li>✓ <strong>Dynamic XML Sitemap:</strong> Generated at <a href="/sitemap.xml" target="_blank" style="color: var(--primary);">/sitemap.xml</a> with automatic <code>&lt;lastmod&gt;</code> timestamps.</li>
                <li>✓ <strong>Search Robots:</strong> Standard directives generated at <a href="/robots.txt" target="_blank" style="color: var(--primary);">/robots.txt</a>.</li>
                <li>✓ <strong>Clean Slugs:</strong> Semantic URL paths (e.g. <code>/movie/the-phantom-of-the-opera-1925</code>).</li>
              </ul>
            </div>

            <div style="margin-top: 2rem;">
              <button type="submit" class="btn btn-primary">Save SEO Settings</button>
            </div>
          </form>
        </div>
      </main>
    </div>
  </div>
</body>
</html>
