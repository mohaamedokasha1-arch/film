<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Manage Movies | AKASHA HUB Admin</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body class="admin-body">
  <div class="admin-layout">
    <%- include('sidebar', { activePage: 'movies' }) %>

    <div class="admin-main">
      <%- include('topbar', { pageTitle: 'Movies Management Library' }) %>

      <main class="admin-content">
        <!-- Search and Filter Bar -->
        <div style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 1.25rem; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
          <form action="/admin/movies" method="GET" style="display: flex; gap: 0.75rem; flex: 1; max-width: 500px;">
            <input type="text" name="q" value="<%= searchQuery %>" placeholder="Search by title, director, external ID..." class="form-input" style="padding: 0.5rem 0.85rem;">
            <input type="hidden" name="status" value="<%= statusFilter %>">
            <button type="submit" class="btn btn-secondary btn-sm">Filter</button>
            <% if (searchQuery) { %>
              <a href="/admin/movies?status=<%= statusFilter %>" class="btn btn-secondary btn-sm">Clear</a>
            <% } %>
          </form>

          <!-- Status Filters -->
          <div style="display: flex; gap: 0.5rem;">
            <a href="/admin/movies?status=all&q=<%= searchQuery %>" class="btn btn-sm <%= statusFilter === 'all' ? 'btn-primary' : 'btn-secondary' %>">All (<%= counts.all %>)</a>
            <a href="/admin/movies?status=published&q=<%= searchQuery %>" class="btn btn-sm <%= statusFilter === 'published' ? 'btn-primary' : 'btn-secondary' %>">Published (<%= counts.published %>)</a>
            <a href="/admin/movies?status=draft&q=<%= searchQuery %>" class="btn btn-sm <%= statusFilter === 'draft' ? 'btn-primary' : 'btn-secondary' %>">Drafts (<%= counts.draft %>)</a>
          </div>
        </div>

        <!-- Movies Table -->
        <div class="table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th style="width: 60px;">Poster</th>
                <th>Title & Year</th>
                <th>Source ID</th>
                <th>Verified License</th>
                <th>Director</th>
                <th>Status</th>
                <th style="text-align: right;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (movies.length === 0) { %>
                <tr>
                  <td colspan="7" style="text-align: center; padding: 3rem; color: var(--text-muted);">
                    No movies match the selected filters.
                  </td>
                </tr>
              <% } %>
              <% movies.forEach(movie => { %>
                <tr>
                  <td>
                    <img src="<%= movie.poster_url || '/images/placeholder-poster.svg' %>" alt="" style="width: 42px; height: 56px; object-fit: cover; border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                  </td>
                  <td>
                    <div style="font-weight: 600; color: #fff;"><%= movie.title %></div>
                    <div style="font-size: 0.75rem; color: var(--text-dim); display: flex; gap: 0.5rem; align-items: center; margin-top: 0.2rem;">
                      <span>Year: <%= movie.year || 'N/A' %></span>
                      <span>•</span>
                      <span>Slug: <code>/movie/<%= movie.slug %></code></span>
                    </div>
                  </td>
                  <td>
                    <a href="<%= movie.source_url %>" target="_blank" rel="noopener" style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--primary);">
                      <%= movie.external_id %>
                    </a>
                  </td>
                  <td>
                    <span class="badge badge-pd" style="font-size: 0.7rem;"><%= movie.license_type %></span>
                  </td>
                  <td><%= movie.director || 'Unknown' %></td>
                  <td>
                    <% if (movie.status === 'published') { %>
                      <span class="badge" style="background: rgba(16,185,129,0.2); color: #34d399;">Published</span>
                    <% } else { %>
                      <span class="badge" style="background: rgba(245,158,11,0.2); color: #fbbf24;">Draft</span>
                    <% } %>
                  </td>
                  <td style="text-align: right;">
                    <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
                      <a href="/movie/<%= movie.slug %>" target="_blank" class="btn btn-secondary btn-sm" title="View Public Page">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                      </a>
                      <a href="/admin/movies/<%= movie.id %>/edit" class="btn btn-secondary btn-sm" title="Edit Metadata">
                        Edit
                      </a>
                      <form action="/admin/movies/<%= movie.id %>/toggle-status" method="POST" style="display: inline;">
                        <button type="submit" class="btn btn-secondary btn-sm" title="Toggle Publish/Draft">
                          <%= movie.status === 'published' ? 'Unpublish' : 'Publish' %>
                        </button>
                      </form>
                      <form action="/admin/movies/<%= movie.id %>/delete" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to permanently delete this movie record?');">
                        <button type="submit" class="btn btn-secondary btn-sm" style="color: var(--accent-rose);" title="Delete">
                          Delete
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <% if (totalPages > 1) { %>
          <nav class="pagination">
            <% if (currentPage > 1) { %>
              <a href="/admin/movies?page=<%= currentPage - 1 %>&status=<%= statusFilter %>&q=<%= searchQuery %>" class="page-btn">&larr; Prev</a>
            <% } %>
            <% for (let p = 1; p <= totalPages; p++) { %>
              <a href="/admin/movies?page=<%= p %>&status=<%= statusFilter %>&q=<%= searchQuery %>" class="page-btn <%= p === currentPage ? 'active' : '' %>"><%= p %></a>
            <% } %>
            <% if (currentPage < totalPages) { %>
              <a href="/admin/movies?page=<%= currentPage + 1 %>&status=<%= statusFilter %>&q=<%= searchQuery %>" class="page-btn">Next &rarr;</a>
            <% } %>
          </nav>
        <% } %>
      </main>
    </div>
  </div>
</body>
</html>
