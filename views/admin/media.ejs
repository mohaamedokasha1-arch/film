<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Media | AKAVOX Admin</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body class="admin-body">
  <div class="admin-layout">
    <%- include('sidebar', { activePage: 'media' }) %>
    <div class="admin-main">
      <%- include('topbar', { pageTitle: 'Media library' }) %>
      <main class="admin-content">
        <% if (successMessage) { %><p style="color:#34d399;"><%= successMessage %></p><% } %>
        <form method="GET" action="/admin/media" style="display:flex;gap:0.5rem;margin-bottom:1rem;max-width:420px;">
          <input class="form-input" name="q" value="<%= searchQuery %>" placeholder="Search media">
          <button class="btn btn-secondary">Search</button>
        </form>
        <form method="POST" action="/admin/media" style="background:var(--bg-surface);padding:1.25rem;border-radius:10px;border:1px solid var(--border-color);margin-bottom:1.5rem;max-width:640px;">
          <h3 style="margin-bottom:0.75rem;">Register media URL</h3>
          <div class="form-group"><label class="form-label">Name</label><input class="form-input" name="name" required></div>
          <div class="form-group"><label class="form-label">URL</label><input class="form-input" name="url" required></div>
          <div class="form-group"><label class="form-label">Type</label>
            <select class="form-select" name="media_type"><option value="image">image</option><option value="video">video</option><option value="document">document</option></select>
          </div>
          <button class="btn btn-primary">Add</button>
        </form>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:1rem;">
          <% files.forEach(f => { %>
            <div style="background:var(--bg-surface);border:1px solid var(--border-color);border-radius:10px;overflow:hidden;">
              <% if (f.media_type === 'image') { %><img src="<%= f.url %>" alt="" style="height:120px;width:100%;object-fit:cover;"><% } %>
              <div style="padding:0.75rem;">
                <div style="font-weight:600;color:#fff;font-size:0.85rem;"><%= f.name %></div>
                <input class="form-input" readonly value="<%= f.url %>" onclick="this.select()" style="margin:0.4rem 0;font-size:0.7rem;">
                <form method="POST" action="/admin/media/<%= f.id %>/delete" onsubmit="return confirm('Remove this media record?');">
                  <button class="btn btn-secondary btn-sm" style="color:var(--accent-rose);">Delete</button>
                </form>
              </div>
            </div>
          <% }) %>
        </div>
      </main>
    </div>
  </div>
</body>
</html>
